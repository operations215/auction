# PayPal REST app credentials (developer.paypal.com > Apps & Credentials).
# Leave blank to run without PayPal; outside production a clearly labelled "simulate payment" button is shown instead.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" for testing with fake money, "live" for real payments.
PAYPAL_ENV=sandbox

# Set to 1 to allow simulated payments in a production build (demos only). Set to 0 to always hide them.
DEMO_PAYMENTS=

# Where the SQLite database and uploaded photos are stored. Defaults to ./data
DATA_DIR=
